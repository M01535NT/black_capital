# =============================================
# Black Corporativo - Variables de Entorno
# Copiar a .env.local y completar valores
# =============================================

# --- Supabase ---
# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (anon key) - segura para el cliente
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service Role Key - SOLO server-side (API routes, Server Actions)
# NUNCA incluir en bundles del cliente
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin Panel ---
# Token temporal para crear el primer admin en /admin/setup.
# Eliminar o rotar despues de crear el primer administrador.
ADMIN_SETUP_TOKEN=

# Legacy fallback local para setup inicial. No usar como login final.
ADMIN_PASSWORD=

# URL publica del sitio para enlaces de invitacion y recuperacion
NEXT_PUBLIC_SITE_URL=

# --- WhatsApp (boton flotante publico) ---
# Numero de WhatsApp en formato internacional sin signo +
# Ejemplo: 521234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- WhatsApp Cloud API (verificacion de acceso a documentos) ---
# REQUERIDO en produccion para el flujo de descarga de documentos/brochures
# protegidos (/api/document-access/*). Sin estas variables, el envio del codigo
# de verificacion falla con 502 y el cliente no puede descargar documentos.
# Se obtienen en Meta for Developers > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombre de la plantilla aprobada que envia el codigo (REQUERIDO en produccion).
WHATSAPP_VERIFICATION_TEMPLATE_NAME=
# Opcionales (tienen valor por defecto):
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Acceso a documentos protegidos ---
# Sal para hashear tokens de sesion/verificacion de documentos.
# Opcional: si se omite, usa SUPABASE_SERVICE_ROLE_KEY como fallback.
# Recomendado definir un secreto dedicado (rotable de forma independiente).
DOCUMENT_ACCESS_SECRET=

# --- Resend (emails transaccionales) ---
# API key de Resend para envio de brochures por email e invitaciones de equipo
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Black Capital <notificaciones@blackmx.vercel.app>

# --- PostHog (analytics) ---
# Opcional. Si se omite, se usa un placeholder dummy
NEXT_PUBLIC_POSTHOG_KEY=phc_dummy12345
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
