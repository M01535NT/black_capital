  {
    "id": "TC001",
    "title": "Search and apply all catalog filters to narrow results",
    "description": "Verifies that typing a search term and selecting Uso, Negocio, and Tipo filters updates the property grid to show matching properties.",
    "category": "Browse Property Catalog",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /inventario"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/inventario\""
      },
      {
        "type": "action",
        "description": "Type \"casa\" into the search text input"
      },
      {
        "type": "action",
        "description": "Select \"Habitacional\" from the \"Uso\" dropdown"
      },
      {
        "type": "action",
        "description": "Select \"Venta\" from the \"Negocio\" dropdown"
      },
      {
        "type": "action",
        "description": "Select \"Casa\" from the \"Tipo\" dropdown"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Property results grid\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify element \"At least one property card in the results grid\" is visible"
      }
    ]
  },
